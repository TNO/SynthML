controllable flip;
controllable __start;
controllable __end;
automaton minimal:
  alphabet flip, __start, __end;
  @state(projected: "s1")
  location s1:
    initial;
    edge __start goto s2;
  @state(projected: "s2")
  @state(projected: "s4")
  location s2:
    edge __end goto s3;
    edge flip;
  @state(projected: "s3")
  location s3:
    marked;
end
