controllable do_a;
controllable do_b;
controllable __start;
controllable __end;
automaton projected:
  alphabet do_a, do_b, __start, __end;
  @state(synthesis_state_space: "__init")
  location s1:
    initial;
    edge __start goto s2;
  @state(synthesis_state_space: "loc1")
  location s2:
    edge do_b goto s3;
    edge do_a goto s4;
  @state(synthesis_state_space: "loc3")
  @state(synthesis_state_space: "loc1")
  @state(synthesis_state_space: "loc5")
  location s3:
    edge __end goto s6;
    edge do_b;
    edge do_a goto s4;
  @state(synthesis_state_space: "loc2")
  @state(synthesis_state_space: "loc1")
  @state(synthesis_state_space: "loc4")
  location s4:
    edge do_b goto s5;
    edge do_a;
  @state(synthesis_state_space: "loc3")
  @state(synthesis_state_space: "loc6")
  @state(synthesis_state_space: "loc1")
  @state(synthesis_state_space: "loc5")
  @state(synthesis_state_space: "loc4")
  @state(synthesis_state_space: "loc7")
  location s5:
    edge __end goto s6;
    edge do_b;
    edge do_a goto s4;
  @state(synthesis_state_space: "__done")
  location s6:
    marked;
end
