controllable do_a;
uncontrollable do_a__result_1;
uncontrollable do_a__result_2;
controllable do_b;
uncontrollable do_b__result_1;
uncontrollable do_b__result_2;
controllable __start;
controllable __end;
automaton synthesis_state_space:
  alphabet do_a, do_a__result_1, do_a__result_2, do_b, do_b__result_1, do_b__result_2, __start, __end;
  @state(Context: "*", Context.__activeAction: 0, Context.done_a: false, Context.done_b: false, sup: "*")
  location __init:
    initial;
    edge __start goto loc1;
  @state(Context: "*", Context.__activeAction: 0, Context.done_a: false, Context.done_b: false, sup: "*")
  location loc1:
    edge do_a goto loc2;
    edge do_b goto loc3;
  @state(Context: "*", Context.__activeAction: 1, Context.done_a: false, Context.done_b: false, sup: "*")
  location loc2:
    edge do_a__result_1 goto loc4;
    edge do_a__result_2 goto loc1;
  @state(Context: "*", Context.__activeAction: 2, Context.done_a: false, Context.done_b: false, sup: "*")
  location loc3:
    edge do_b__result_1 goto loc5;
    edge do_b__result_2 goto loc1;
  @state(Context: "*", Context.__activeAction: 0, Context.done_a: true, Context.done_b: false, sup: "*")
  location loc4:
    edge do_b goto loc6;
  @state(Context: "*", Context.__activeAction: 0, Context.done_a: false, Context.done_b: true, sup: "*")
  location loc5:
    edge __end goto __done;
  @state(Context: "*", Context.__activeAction: 2, Context.done_a: true, Context.done_b: false, sup: "*")
  location loc6:
    edge do_b__result_1 goto loc7;
    edge do_b__result_2 goto loc4;
  @state(Context: "*", Context.__activeAction: 0, Context.done_a: true, Context.done_b: true, sup: "*")
  location loc7:
    edge __end goto __done;
  @state(Context: "*", Context.__activeAction: 0, Context.done_a: false, Context.done_b: true, sup: "*")
  @state(Context: "*", Context.__activeAction: 0, Context.done_a: true, Context.done_b: true, sup: "*")
  location __done:
    marked;
end
