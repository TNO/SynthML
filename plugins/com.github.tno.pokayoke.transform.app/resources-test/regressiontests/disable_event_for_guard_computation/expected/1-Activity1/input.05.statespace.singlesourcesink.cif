controllable flip;
uncontrollable flip__result_1;
uncontrollable flip__result_2;
controllable __start;
controllable __end;
automaton synthesis_state_space:
  alphabet flip, flip__result_1, flip__result_2, __start, __end;
  @state(Class1: "*", Class1.__activeAction: 0, Class1.val: false, sup: "*")
  @state(Class1: "*", Class1.__activeAction: 0, Class1.val: true, sup: "*")
  location __init:
    initial;
    edge __start goto loc1;
    edge __start goto loc2;
  @state(Class1: "*", Class1.__activeAction: 0, Class1.val: false, sup: "*")
  location loc1:
    edge flip goto loc3;
  @state(Class1: "*", Class1.__activeAction: 0, Class1.val: true, sup: "*")
  location loc2:
    edge __end goto __done;
  @state(Class1: "*", Class1.__activeAction: 1, Class1.val: false, sup: "*")
  location loc3:
    edge flip__result_1 goto loc2;
    edge flip__result_2 goto loc1;
  @state(Class1: "*", Class1.__activeAction: 0, Class1.val: true, sup: "*")
  location __done:
    marked;
end
